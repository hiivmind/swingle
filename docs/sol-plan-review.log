     1	# Detection Algorithm
     2	
     3	Shared by `plugin-portability`. Run once at start (Phase 1).
     4	
     5	---
     6	
     7	## Step D1: Scan for Metadata Sources
     8	
     9	```
    10	FUNCTION SCAN_METADATA_SOURCES(plugin_path):
    11	
    12	  source_definitions = [
    13	    {
    14	      path:   ".claude-plugin/plugin.json",
    15	      fields: ["name", "description", "version", "author.name",
    16	               "author.email", "homepage", "repository", "license", "keywords"]
    17	    },
    18	    {
    19	      path:   ".cursor-plugin/plugin.json",
    20	      fields: ["name", "displayName", "description", "version", "author.name",
    21	               "author.email", "homepage", "repository", "license", "keywords"]
    22	    },
    23	    {
    24	      path:   ".codex-plugin/plugin.json",
    25	      fields: ["name", "description", "version"]
    26	    },
    27	    {
    28	      path:   "gemini-extension.json",
    29	      fields: ["name", "description", "version"]
    30	    },
    31	    {
    32	      path:   "openclaw.plugin.json",
    33	      fields: ["name", "description", "version"]
    34	    },
    35	    {
    36	      path:   "package.json",
    37	      fields: ["name", "version", "description"]
    38	    },
    39	    {
    40	      path:   "AGENTS.md",
    41	      fields: ["name",        # from first "# Heading" line
    42	               "description"] # from first non-heading paragraph
    43	    },
    44	    {
    45	      path:   "skills/*/SKILL.md",   # glob — one entry per matched file
    46	      fields: ["name",               # YAML "name:" field, or skill dir name as fallback
    47	               "description"]        # YAML "description:" field
    48	    }
    49	  ]
    50	
    51	  found_sources = []
    52	
    53	  FOR source IN source_definitions:
    54	    IF file_exists(plugin_path / source.path):
    55	      data   = parse_fields(plugin_path / source.path, source.fields)
    56	      score  = count_populated_fields(data)
    57	      found_sources.append({ path: source.path, fields: source.fields,
    58	                             data: data, score: score })
    59	
    60	  IF found_sources IS EMPTY:
    61	    STOP with error:
    62	      "No recognisable plugin signals found in `<plugin_path>`.
    63	       Provide at least one platform manifest or one `skills/*/SKILL.md`
    64	       with `name` and `description` frontmatter."
    65	
    66	  RETURN found_sources
    67	```
    68	
    69	---
    70	
    71	## Step D2: Score and Elect Canonical Source
    72	
    73	```
    74	FUNCTION ELECT_CANONICAL(found_sources):
    75	
    76	  # Tie-breaking order when scores are equal (index 0 = highest priority)
    77	  tie_break_order = [
    78	    ".claude-plugin/plugin.json",
    79	    ".cursor-plugin/plugin.json",
    80	    ".codex-plugin/plugin.json",
    81	    "gemini-extension.json",
    82	    "openclaw.plugin.json",
    83	    "package.json",
    84	    "AGENTS.md",
    85	    # first skills/*/SKILL.md alphabetically by directory name
    86	  ]
    87	
    88	  sorted_sources = SORT found_sources BY:
    89	    PRIMARY   score          DESCENDING
    90	    SECONDARY tie_break_order index  ASCENDING
    91	      # for skills/*/SKILL.md ties: sort alphabetically by skill directory name
    92	
    93	  canonical = sorted_sources[0]
    94	  remaining = sorted_sources[1:]
    95	
    96	  RETURN canonical, remaining
    97	```
    98	
    99	---
   100	
   101	## Step D3: Build Canonical Metadata Model
   102	
   103	```
   104	FUNCTION BUILD_METADATA_MODEL(canonical, remaining):
   105	
   106	  hard_fallbacks = {
   107	    "name":         basename(plugin_path),          # directory basename
   108	    "displayName":  title_case(name),               # replace - and _ with spaces,
   109	                                                    # capitalise each word
   110	    "description":  "",      # flag as missing
   111	    "version":      "0.1.0",
   112	    "author.name":  "",      # flag as missing
   113	    "author.email": "",      # flag as missing
   114	    "homepage":     "",
   115	    "repository":   "",
   116	    "license":      "MIT",
   117	    "keywords":     []
   118	  }
   119	
   120	  model = COPY canonical.data
   121	
   122	  FOR field IN hard_fallbacks.keys():
   123	    IF model[field] IS EMPTY OR ABSENT:
   124	      # Gap-fill from remaining sources in descending score order
   125	      FOR source IN remaining:
   126	        IF source.data[field] IS NOT EMPTY:
   127	          model[field] = source.data[field]
   128	          model[field + ".source"] = source.path
   129	          BREAK
   130	      # If still empty after all sources, apply hard fallback
   131	      IF model[field] IS STILL EMPTY OR ABSENT:
   132	        model[field] = hard_fallbacks[field]
   133	        model[field + ".source"] = "hard_fallback"
   134	
   135	  # Always derived — never read from any source
   136	  model["marketplaceName"] = model["name"] + "-dev"
   137	
   138	  RETURN model
   139	```
   140	
   141	---
   142	
   143	## Step D4: Print Inference Summary
   144	
   145	```
   146	FUNCTION PRINT_INFERENCE_SUMMARY(canonical, model):
   147	
   148	  PRINT "## Metadata inferred"
   149	  PRINT "  canonical source: <canonical.path>  (<canonical.score> fields)"
   150	
   151	  FOR field IN ["name", "description", "version", "author.name", "author.email",
   152	                "homepage", "repository", "license", "keywords"]:
   153	    value  = model[field]
   154	    source = model[field + ".source"]
   155	
   156	    IF source == "hard_fallback" AND value == "" OR value == []:
   157	      PRINT "  <field>:  [missing — not found in any source]"
   158	    ELSE IF source == "hard_fallback":
   159	      PRINT "  <field>:  <value>  (hard fallback)"
   160	    ELSE:
   161	      PRINT "  <field>:  <value>  (from <source>)"
   162	```
   163	
   164	Example output:
   165	
   166	```
   167	## Metadata inferred
   168	  canonical source: .claude-plugin/plugin.json  (9 fields)
   169	  name:          my-plugin        (from .claude-plugin/plugin.json)
   170	  description:   Does X for Y.   (from .claude-plugin/plugin.json)
   171	  version:       1.2.0            (from .cursor-plugin/plugin.json)
   172	  author.name:   [missing — not found in any source]
   173	  author.email:  [missing — not found in any source]
   174	  homepage:                       (empty string — not found)
   175	  repository:                     (empty string — not found)
   176	  license:       MIT              (hard fallback)
   177	  keywords:      []               (hard fallback)
   178	```
   179	
   180	Fields still missing after all sources are checked are flagged here and repeated
   181	in the final report.
   182	
   183	---
   184	
   185	## Step D5: Classify Repo Shape
   186	
   187	```pseudocode
   188	FUNCTION CLASSIFY_SHAPE(found_sources):
   189	  platform_manifests = FILTER found_sources WHERE path IN [
   190	    ".claude-plugin/plugin.json",
   191	    ".cursor-plugin/plugin.json",
   192	    ".codex-plugin/plugin.json",
   193	    "gemini-extension.json",
   194	    "openclaw.plugin.json",
   195	  ]
   196	
   197	  has_skills = ANY source.path MATCHES "skills/*/SKILL.md"
   198	  has_marketplace = ANY source.path MATCHES "*marketplace.json"
   199	
   200	  manifest_count = len(platform_manifests)
   201	
   202	  IF manifest_count == 0 AND has_skills:
   203	    RETURN "bare-skill-repo"
   204	  ELIF manifest_count == 1:
   205	    RETURN "single-platform-plugin"
   206	  ELIF manifest_count >= 2:
   207	    RETURN "multi-platform-source"
   208	  ELIF has_marketplace AND NOT has_skills:
   209	    RETURN "curated-distribution"
   210	  ELSE:
   211	    RETURN "unclassified"
   212	```
   213	
   214	Shape definitions:
   215	
   216	| Shape | Description |
   217	|-------|-------------|
   218	| `bare-skill-repo` | Skills exist but no platform manifests |
   219	| `single-platform-plugin` | One platform's manifest present |
   220	| `multi-platform-source` | Two or more platform manifests |
   221	| `curated-distribution` | Marketplace packaging without upstream skill authoring |
   222	| `unclassified` | Does not match any known pattern |
     1	# Consolidated Inventory Pattern
     2	
     3	Referenced by `skills/plugin-portability/SKILL.md`. Merges the assessment
     4	skill's 7 inventory substeps with the uplift skill's asset discovery and
     5	conflict detection into a single pass.
     6	
     7	```pseudocode
     8	INVENTORY(plugin_path, computed):
     9	
    10	  ## 2.1 Discover Assets
    11	  ## Glob skills, parse frontmatter, collect agents/commands/hooks.
    12	  raw_skills = Glob(plugin_path + "/skills/*/SKILL.md")
    13	  computed.skills = [
    14	    { path: s, dir: dirname(s), name: basename(dirname(s)),
    15	      frontmatter: parse_yaml_frontmatter(Read(s)) }
    16	    FOR s IN raw_skills
    17	  ]
    18	  computed.commands = Glob(plugin_path + "/commands/*.md")
    19	  computed.agents   = Glob(plugin_path + "/agents/*.md")
    20	  computed.existing_hooks = read_json_if_exists(plugin_path + "/hooks/hooks.json")
    21	
    22	  computed.created = []   # { path, platform }
    23	  computed.skipped = []   # { path, platform }
    24	  computed.flagged = []   # strings
    25	
    26	  ## 2.2 Check Platform Manifests
    27	  ## Derive paths from REGISTRY. Record { platform, path, status }.
    28	  manifest_checks = []
    29	  FOR pid, spec IN REGISTRY:
    30	    IF spec.manifest.path IS NOT null:
    31	      manifest_checks.append({ platform: pid, path: spec.manifest.path })
    32	    IF spec.manifest.marketplace_path IS NOT null:
    33	      manifest_checks.append({ platform: pid, path: spec.manifest.marketplace_path })
    34	
    35	  computed.manifest_results = []
    36	  FOR check IN manifest_checks:
    37	    status = IF file_exists(plugin_path + "/" + check.path) THEN "PRESENT" ELSE "MISSING"
    38	    computed.manifest_results.append({ platform: check.platform, path: check.path, status: status })
    39	
    40	  ## 2.3 Check Context Files
    41	  ## Derive from REGISTRY primary_file + secondary_files.
    42	  context_checks = []
    43	  FOR pid, spec IN REGISTRY:
    44	    context_checks.append({ platform: pid, path: spec.context.primary_file })
    45	    FOR secondary IN spec.context.secondary_files:
    46	      context_checks.append({ platform: pid, path: secondary })
    47	
    48	  computed.context_results = []
    49	  FOR check IN context_checks:
    50	    status = IF file_exists(plugin_path + "/" + check.path) THEN "PRESENT" ELSE "MISSING"
    51	    computed.context_results.append({ platform: check.platform, path: check.path, status: status })
    52	
    53	  ## 2.4 Check Tool Reference Sidecars
    54	  ## Shape-aware: bare-skill repos need per-skill sidecars (no context file to carry
    55	  ## shared references). Plugin repos can use shared references via context files.
    56	  platform_spec_files = ["codex.md", "gemini-cli.md", "cursor.md",
    57	                         "antigravity.md", "openclaw.md"]
    58	  computed.sidecar_results = []
    59	
    60	  IF computed.uplift_target IS NOT null:
    61	    strategy = sidecar_strategy(computed.uplift_target)
    62	  ELSE:
    63	    IF computed.shape IN ["bare-skill-repo"]:
    64	      strategy = "per-skill"
    65	    ELSE:
    66	      strategy = "shared"
    67	
    68	  IF strategy == "per-skill":
    69	    # Per-skill spec files — no context file to carry shared refs
    70	    FOR skill IN computed.skills:
    71	      FOR spec_file IN platform_spec_files:
    72	        target = "skills/" + skill.dir + "/references/" + spec_file
    73	        status = IF file_exists(plugin_path + "/" + target) THEN "PRESENT" ELSE "MISSING"
    74	        computed.sidecar_results.append({ skill: skill.dir, file: spec_file, status: status })
    75	
    76	  ELIF strategy == "shared":
    77	    # Plugins have context files — check shared references instead
    78	    shared_paths = ["lib/references/platforms/", "references/platforms/", "lib/references/"]
    79	    FOR spec_file IN platform_spec_files:
    80	      found = false
    81	      FOR shared IN shared_paths:
    82	        IF file_exists(plugin_path + "/" + shared + spec_file):
    83	          found = true
    84	          computed.sidecar_results.append({ skill: "(shared)", file: shared + spec_file, status: "PRESENT" })
    85	          BREAK
    86	      IF NOT found:
    87	        computed.sidecar_results.append({ skill: "(shared)", file: spec_file, status: "MISSING" })
    88	
    89	  ## 2.5 Check Frontmatter Compatibility
    90	  ## name and description are required for all platforms.
    91	  computed.frontmatter_results = []
    92	  FOR skill IN computed.skills:
    93	    fm = skill.frontmatter
    94	    IF fm.name AND fm.description:
    95	      status = "COMPATIBLE"
    96	    ELSE:
    97	      missing = []
    98	      IF NOT fm.name:        missing.append("name")
    99	      IF NOT fm.description: missing.append("description")
   100	      status = "MISSING: " + join(missing, ", ")
   101	    computed.frontmatter_results.append({ skill: skill.dir, status: status })
   102	
   103	  ## 2.6 Check Hooks
   104	  ## Read hooks.json and hooks-cursor.json contents for later phases.
   105	  hook_paths = [
   106	    { path: "hooks/hooks.json",        key: "claude_hooks" },
   107	    { path: "hooks/hooks-cursor.json", key: "cursor_hooks" },
   108	  ]
   109	
   110	  computed.hook_results = []
   111	  FOR hp IN hook_paths:
   112	    full = plugin_path + "/" + hp.path
   113	    IF file_exists(full):
   114	      computed[hp.key] = read_json(full)
   115	      computed.hook_results.append({ path: hp.path, status: "PRESENT" })
   116	    ELSE:
   117	      computed[hp.key] = NULL
   118	      computed.hook_results.append({ path: hp.path, status: "MISSING" })
   119	
   120	  ## 2.7 Check Session-Start Injection
   121	  ## Delegate to injection-checks.md for the 8-component verification.
   122	  using_path = "skills/using-" + computed.metadata.name + "/SKILL.md"
   123	  IF file_exists(plugin_path + "/" + using_path):
   124	    computed.injection_results = check_injection_components(computed)   # see injection-checks.md
   125	    computed.injection_status  = compute_injection_summary(computed.injection_results)
   126	  ELSE:
   127	    computed.injection_results = NULL
   128	    computed.injection_status  = "NOT CONFIGURED"
   129	
   130	  ## 2.8 Collect Existing Files for Conflict Detection
   131	  ## Union of all PRESENT paths from 2.2, 2.3, 2.4, 2.6.
   132	  computed.existing_files = []
   133	  FOR r IN computed.manifest_results:
   134	    IF r.status == "PRESENT":
   135	      computed.existing_files.append({ path: r.path, platform: r.platform })
   136	  FOR r IN computed.context_results:
   137	    IF r.status == "PRESENT":
   138	      computed.existing_files.append({ path: r.path, platform: r.platform })
   139	  FOR r IN computed.sidecar_results:
   140	    IF r.status == "PRESENT":
   141	      p = "skills/" + r.skill + "/references/" + r.file
   142	      computed.existing_files.append({ path: p, platform: platform_for_spec(r.file) })
   143	  FOR r IN computed.hook_results:
   144	    IF r.status == "PRESENT":
   145	      computed.existing_files.append({ path: r.path, platform: platform_for_hooks(r.path) })
   146	
   147	  # Any file that already exists will be skipped during generation (idempotent).
   148	  computed.skipped = computed.existing_files
   149	```
