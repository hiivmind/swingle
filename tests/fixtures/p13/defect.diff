+import pytest
+from wordstats.cli import main
+
+
+class TestCLI:
+    def test_default_top_5(self, tmp_path, capsys):
+        text_file = tmp_path / "input.txt"
+        text_file.write_text("apple banana apple cherry banana apple date elderberry banana cherry")
+        
+        result = main([str(text_file)])
+        
+        assert result == 0
+        captured = capsys.readouterr()
+        expected = "1. apple  3\n2. banana  3\n3. cherry  2\n4. date  1\n5. elderberry  1\n"
+        assert captured.out == expected
+
+    def test_top_flag(self, tmp_path, capsys):
+        text_file = tmp_path / "input.txt"
+        text_file.write_text("apple banana apple cherry banana apple date elderberry banana cherry")
+        
+        result = main([str(text_file), "--top", "3"])
+        
+        assert result == 0
+        captured = capsys.readouterr()
+        expected = "1. apple  3\n2. banana  3\n3. cherry  2\n"
+        assert captured.out == expected
+
+    def test_top_flag_larger_than_unique(self, tmp_path, capsys):
+        text_file = tmp_path / "input.txt"
+        text_file.write_text("apple banana")
+        
+        result = main([str(text_file), "--top", "10"])
+        
+        assert result == 0
+        captured = capsys.readouterr()
+        expected = "1. apple  1\n2. banana  1\n"
+        assert captured.out == expected
+
+    def test_file_not_found(self, tmp_path, capsys):
+        nonexistent = tmp_path / "does_not_exist.txt"
+        
+        result = main([str(nonexistent)])
+        
+        assert result == 2
+        captured = capsys.readouterr()
+        assert captured.err == f"error: {nonexistent} not found\n"
+        assert captured.out == ""
+
+    def test_empty_file(self, tmp_path, capsys):
+        text_file = tmp_path / "empty.txt"
+        text_file.write_text("")
+        
+        result = main([str(text_file)])
+        
+        assert result == 0
+        captured = capsys.readouterr()
+        assert captured.out == ""
+
+    def test_output_format_exact(self, tmp_path, capsys):
+        text_file = tmp_path / "input.txt"
+        text_file.write_text("the the the cat cat dog")
+        
+        result = main([str(text_file), "--top", "3"])
+        
+        assert result == 0
+        captured = capsys.readouterr()
+        lines = captured.out.split("\n")
+        assert lines[0] == "1. the  3"
+        assert lines[1] == "2. cat  2"
+        assert lines[2] == "3. dog  1"
+        assert lines[3] == ""
+
+    def test_top_1(self, tmp_path, capsys):
+        text_file = tmp_path / "input.txt"
+        text_file.write_text("apple banana apple cherry banana apple")
+        
+        result = main([str(text_file), "--top", "1"])
+        
+        assert result == 0
+        captured = capsys.readouterr()
+        expected = "1. apple  3\n"
+        assert captured.out == expected
