#!/usr/bin/env bash
set -u

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT_DIR" || exit 1

status=0
pass() { echo "PASS: $1"; }
fail() { echo "FAIL: $1"; status=1; }

if [ -f skills/sdd/SKILL.md ]; then
  pass "skills/sdd/SKILL.md exists"
else
  fail "skills/sdd/SKILL.md exists"
fi

if [ -f controllers/codex.md ]; then
  pass "controllers/codex.md exists"
else
  fail "controllers/codex.md exists"
fi

if [ -f controllers/grok.md ]; then
  pass "controllers/grok.md exists"
else
  fail "controllers/grok.md exists"
fi

if [ -f skills/delegate/SKILL.md ]; then
  pass "skills/delegate/SKILL.md exists"
else
  fail "skills/delegate/SKILL.md exists"
fi

if [ -f skills/delegate/agents/openai.yaml ]; then
  pass "skills/delegate/agents/openai.yaml exists"
else
  fail "skills/delegate/agents/openai.yaml exists"
fi

if [ -f skills/swingle-setup/SKILL.md ]; then
  pass "skills/swingle-setup/SKILL.md exists"
else
  fail "skills/swingle-setup/SKILL.md exists"
fi

if [ -f skills/swingle-setup/agents/openai.yaml ]; then
  pass "skills/swingle-setup/agents/openai.yaml exists"
else
  fail "skills/swingle-setup/agents/openai.yaml exists"
fi

if [ -f contracts/reader-contract.md ]; then
  pass "contracts/reader-contract.md exists"
else
  fail "contracts/reader-contract.md exists"
fi

if [ -f skills/sdd/SKILL.md ]; then
  ROOT=$(cd "$(dirname skills/sdd/SKILL.md)/../.." && pwd) || ROOT=""
else
  ROOT=""
fi
if [ -n "$ROOT" ] && [ -d "$ROOT/core" ] && [ -d "$ROOT/providers" ]; then
  pass "derived root contains core/ and providers/"
else
  fail "derived root contains core/ and providers/"
fi

if [ -n "$ROOT" ] && python3 scripts/validate-packs --root "$ROOT" >/dev/null 2>&1; then
  pass "validate-packs is clean"
else
  fail "validate-packs is clean"
fi

exit "$status"
