   285	```python
   286	#!/usr/bin/env python3
   287	"""Validate sdd-dispatch provider packs; resolve models; simulate Step 0."""
   288	import argparse, json, os, re, sys
   289	from pathlib import Path
   290	
   291	MANIFEST_REQ = ["schema-version", "id", "cli", "verified-version", "version-argv",
   292	                "resume-argv", "session-source", "stall-signal", "sandbox"]
   293	ENUMS = {"session-source": {"session-list", "exec-output", "conversation-id"},
   294	         "stall-signal": {"log-age", "process+print-timeout"},
   295	         "sandbox": {"enforced", "none"}}
   296	TIERS = {"cheapest", "standard", "most-capable"}
   297	LANES = {"implement", "review", "any"}
   298	STATUSES = {"verified", "experimental", "unavailable", "superseded", "rejected"}
   299	ELIGIBLE = {"verified", "experimental"}
   300	NAME_RE = re.compile(r"^[a-z0-9-]+$")
   301	META_RE = re.compile(r"[;|&<>$]")
   302	CONFIG_KEYS = {"disable": list, "default_provider": str, "providers_by_lane": dict,
   303	               "require-verified-version": bool, "note": str}
   304	findings = []
   305	
   306	def find(msg): findings.append(msg)
   307	
   308	def parse_front_matter(path):
   309	    lines = path.read_text().splitlines()
   310	    if not lines or lines[0] != "---":
   311	        find(f"{path}: no front-matter"); return {}
   312	    fm, i = {}, 1
   313	    while i < len(lines) and lines[i] != "---":
   314	        m = re.match(r"^([a-z-]+):\s*(.*)$", lines[i])
   315	        if m:
   316	            k, v = m.group(1), re.sub(r"\s+#.*$", "", m.group(2)).strip()
   317	            if v.startswith("["):
   318	                try: v = json.loads(v.replace("'", '"'))
   319	                except json.JSONDecodeError: find(f"{path}: {k} is not a valid argv array"); v = []
   320	            else: v = v.strip('"')
   321	            fm[k] = v
   322	        i += 1
   323	    return fm
   324	
   325	def check_manifest(pack_dir):
   326	    fm = parse_front_matter(pack_dir / "pack.md")
   327	    for k in MANIFEST_REQ:
   328	        if k not in fm: find(f"{pack_dir}/pack.md: missing field {k}")
   329	    for k, allowed in ENUMS.items():
   330	        if k in fm and fm.get(k) not in allowed: find(f"{pack_dir}/pack.md: bad enum {k}={fm[k]}")
   331	    for k in ("id", "cli"):
   332	        if k in fm and not NAME_RE.match(str(fm[k])): find(f"{pack_dir}/pack.md: {k} fails [a-z0-9-]+")
   333	    if fm.get("id") and fm["id"] != pack_dir.name: find(f"{pack_dir}/pack.md: id != dirname")
   334	    if "detect" in fm: find(f"{pack_dir}/pack.md: shell 'detect' forbidden; detection derives from cli")
   335	    for k in [k for k in fm if k.endswith("-argv")]:
   336	        v = fm[k]
   337	        if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
   338	            find(f"{pack_dir}/pack.md: {k} must be an argv array of strings"); continue
   339	        if v and fm.get("cli") and v[0] != fm["cli"]:
   340	            find(f"{pack_dir}/pack.md: {k} argv[0] must equal cli ({v[0]} != {fm['cli']})")
   341	        for tok in v[1:]:
   342	            if META_RE.search(tok): find(f"{pack_dir}/pack.md: {k} contains shell metacharacter: {tok}")
   343	            if tok.startswith("/"): find(f"{pack_dir}/pack.md: {k} contains absolute path: {tok}")
   344	            for ph in re.findall(r"\{([a-z_]+)\}", tok):
   345	                if ph != "session_id": find(f"{pack_dir}/pack.md: unknown placeholder {{{ph}}}")
   346	    if fm.get("session-source") == "session-list" and "session-list-argv" not in fm:
   347	        find(f"{pack_dir}/pack.md: session-list-argv required for session-source: session-list")
   348	    return fm
   349	
   350	def parse_models(pack_dir):
   351	    rows, in_doc = [], False
   352	    for line in (pack_dir / "models.md").read_text().splitlines():
   353	        if line.lower().startswith("## documentary"): in_doc = True
   354	        if in_doc: continue
   355	        cells = [c.strip() for c in line.strip().strip("|").split("|")]
   356	        if len(cells) == 7 and cells[0] in TIERS:
   357	            tier, lane, prio, model, status = cells[0], cells[1], cells[2], cells[3], cells[4]
   358	            if lane not in LANES: find(f"{pack_dir}/models.md: bad lane {lane}")
   359	            if status not in STATUSES: find(f"{pack_dir}/models.md: bad status {status}")
   360	            if not prio.isdigit() or int(prio) < 1: find(f"{pack_dir}/models.md: bad priority {prio}")
   361	            else: rows.append({"tier": tier, "lane": lane, "prio": int(prio),
   362	                              "model": model, "status": status})
   363	    seen = set()
   364	    for r in rows:
   365	        key = (r["tier"], r["lane"], r["prio"])
   366	        if key in seen: find(f"{pack_dir}/models.md: duplicate priority {key}")
   367	        seen.add(key)
   368	    for (tier, lane) in {(r["tier"], r["lane"]) for r in rows}:
   369	        if not any(r["prio"] == 1 for r in rows if (r["tier"], r["lane"]) == (tier, lane)):
   370	            find(f"{pack_dir}/models.md: ({tier},{lane}) has no priority 1 row")
   371	    return rows
   372	
   373	def parse_roles(root):
   374	    roles = {}
   375	    p = root / "core" / "roles.md"
   376	    if not p.exists(): find(f"{p}: missing"); return roles
   377	    for line in p.read_text().splitlines():
   378	        cells = [c.strip() for c in line.strip().strip("|").split("|")]
   379	        if len(cells) >= 3 and cells[1] in TIERS and cells[2] in (LANES - {"any"}):
   380	            roles[cells[0].lower()] = (cells[1], cells[2])
   381	    return roles
   382	
   383	def candidate_order(rows, tier, lane, excl):
   384	    elig = [r for r in rows if r["status"] in ELIGIBLE and r["model"] not in excl]
   385	    exact = sorted([r for r in elig if (r["tier"], r["lane"]) == (tier, lane)], key=lambda r: r["prio"])
   386	    anyl = sorted([r for r in elig if (r["tier"], r["lane"]) == (tier, "any")], key=lambda r: r["prio"])
   387	    return exact + anyl
   388	
   389	def load_config(path):
   390	    try: cfg = json.loads(Path(path).read_text())
   391	    except (OSError, json.JSONDecodeError) as e:
   392	        find(f"{path}: unreadable/malformed ({e})"); return None
   393	    for k, v in cfg.items():
   394	        if k not in CONFIG_KEYS: print(f"warn: unknown key {k}", file=sys.stderr); continue
   395	        if not isinstance(v, CONFIG_KEYS[k]): find(f"{path}: {k} has wrong type")
   396	    for lane in (cfg.get("providers_by_lane") or {}):
   397	        if lane not in ("implement", "review"): find(f"{path}: providers_by_lane bad lane {lane}")
   398	    disabled = set(cfg.get("disable") or [])
   399	    if cfg.get("default_provider") in disabled: find(f"{path}: default_provider is disabled")
   400	    for lane, pid in (cfg.get("providers_by_lane") or {}).items():
   401	        if pid in disabled: find(f"{path}: providers_by_lane[{lane}] names disabled provider {pid}")
   402	    return cfg
   403	
   404	def main():
   405	    ap = argparse.ArgumentParser()
   406	    ap.add_argument("--root", default=".")
   407	    ap.add_argument("--resolve", nargs=2, metavar=("ROLE", "PROVIDER"))
   408	    ap.add_argument("--exclude", action="append", default=[], metavar="PROVIDER:MODEL")
   409	    ap.add_argument("--check-config")
   410	    ap.add_argument("--step0", action="store_true")
   411	    ap.add_argument("--config")
   412	    ap.add_argument("--path-dir", action="append", default=[])
   413	    ap.add_argument("--lever")
   414	    ap.add_argument("--task-provider")
   415	    a = ap.parse_args()
   416	    root = Path(a.root)
   417	    if a.check_config:
   418	        load_config(a.check_config)
   419	    else:
   420	        packs = sorted(p for p in (root / "providers").glob("*/") if (p / "pack.md").exists()) \
   421	                if (root / "providers").exists() else []
   422	        if not packs: find(f"{root}: no packs found")
   423	        fms, rows_by_id = {}, {}
   424	        for p in packs:
   425	            fms[p.name] = check_manifest(p)
   426	            for f in ("models.md", "verification-log.md"):
   427	                if not (p / f).exists(): find(f"{p}: missing {f}")
   428	            if (p / "models.md").exists(): rows_by_id[p.name] = parse_models(p)
   429	        excl = {}
   430	        for e in a.exclude:
   431	            prov, _, model = e.partition(":")
   432	            excl.setdefault(prov, set()).add(model)
   433	        if a.step0:
   434	            if a.lever == "native-subagents":
   435	                print("native-subagents: bypass external dispatch (no provider selected)")
   436	            else:
   437	                installed = []
   438	                for pid, fm in fms.items():
   439	                    cli = fm.get("cli", "")
   440	                    if any((Path(d) / cli).exists() and os.access(Path(d) / cli, os.X_OK)
   441	                           for d in a.path_dir): installed.append(pid)
   442	                print(f"installed: {' '.join(installed) or '(none)'}")
   443	                cfg = load_config(a.config) if a.config else {}
   444	                if cfg is None: cfg = {}
   445	                active = [p_ for p_ in installed if p_ not in set(cfg.get("disable") or [])]
   446	                if not active: find("no active providers")
   447	                else:
   448	                    print(f"active: {' '.join(active)}")
   449	                    chosen = (a.task_provider or a.lever or
   450	                              cfg.get("default_provider") or
   451	                              ("codex" if "codex" in active else (active[0] if len(active) == 1 else None)))
   452	                    if chosen and chosen not in active: find(f"routed provider inactive: {chosen}")
   453	                    elif chosen: print(f"provider: {chosen}")
   454	                    else: find("route-selection: ask user (multiple active, no policy)")
   455	        elif a.resolve:
   456	            role, provider = a.resolve[0].lower(), a.resolve[1]
   457	            roles = parse_roles(root)
   458	            tl = next((v for k, v in roles.items() if role in k), None)
   459	            if not tl: find(f"unknown role: {role}")
   460	            elif provider not in rows_by_id: find(f"unknown provider: {provider}")
   461	            else:
   462	                order = candidate_order(rows_by_id[provider], tl[0], tl[1],
   463	                                        excl.get(provider, set()))
   464	                if order:
   465	                    r = order[0]
   466	                    print(f"{role} -> {tl} -> {r['model']} (P{r['prio']}, {r['status']}); "
   467	                          f"fallback order: {', '.join(x['model'] for x in order)}")
   468	                else: find(f"no eligible model for {tl} in {provider}")
   469	    for f in findings: print(f)
   470	    sys.exit(1 if findings else 0)
   471	
   472	if __name__ == "__main__":
   473	    main()
   474	```
